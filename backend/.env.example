# ─── Server Configuration ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Database (PostgreSQL Connection URL) ───────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/earnx?sslmode=prefer"

# ─── JWT Authentication Secrets ─────────────────────────────────────────────
JWT_USER_SECRET="your_user_jwt_secret_key_here"
JWT_ADMIN_SECRET="your_admin_jwt_secret_key_here"

# ─── CORS Allowed Origins (Comma-separated) ─────────────────────────────────
# CORS_ORIGINS="https://earnxcapital.io,https://www.earnxcapital.io"

# ─── SMS Gateway (api.sms.net.bd) ───────────────────────────────────────────
SMS_API_KEY="your_sms_api_key_here"
SMS_API_URL="https://api.sms.net.bd/sendsms"
SMS_SENDER_ID=""

# ─── SMTP Email Service (Resend / Mailgun / SendGrid) ──────────────────────
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_USER="resend"
SMTP_PASS="re_your_smtp_api_key_here"
SMTP_FROM="EarnX Capital <noreply@earnxcapital.io>"

# ─── HilltopAds / VAST Video Ads Configuration ──────────────────────────────
HILLTOPADS_VAST_TAG_URL="https://crookedagreement.com/d.maFyzUdtGYNpvCZZGNUK/leOm/9zuKZ_Uelgk/PRTRcZ1LMqTgACy/N/z_clt-NazZU/xiMtD/IF4pMNQQ"
VAST_TAG_URL="https://crookedagreement.com/d.maFyzUdtGYNpvCZZGNUK/leOm/9zuKZ_Uelgk/PRTRcZ1LMqTgACy/N/z_clt-NazZU/xiMtD/IF4pMNQQ"
