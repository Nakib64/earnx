generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  DISABLED
  ACTIVE
  BLOCKED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  COMMISSION
  ADMIN_ADJUSTMENT
  PREMIUM_WEEKLY_PAYOUT
  INVESTMENT_DEPOSIT
  INVESTMENT_PAYOUT
}

enum CommissionType {
  ACTIVATION
  PREMIUM
}

model Admin {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  name          String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model User {
  id                     String            @id @default(uuid())
  phone                  String            @unique
  password_hash          String
  full_name              String?
  referral_code          String            @unique
  referred_by_id         String?
  status                 UserStatus        @default(DISABLED)
  wallet_balance         Decimal           @default(0.00) @db.Decimal(12, 2)
  designation_id         String?

  // Premium status fields (Weekly payouts for 1 year / 52 weeks max)
  is_premium             Boolean           @default(false)
  premium_started_at     DateTime?
  premium_expires_at     DateTime?
  premium_payout_count   Int               @default(0)
  last_premium_payout_at DateTime?

  referred_by         User?               @relation("ReferralTree", fields: [referred_by_id], references: [id], onDelete: SetNull)
  referrals           User[]              @relation("ReferralTree")
  designation         Designation?        @relation(fields: [designation_id], references: [id], onDelete: SetNull)
  transactions        WalletTransaction[]
  activation_requests ActivationRequest[]  @relation("UserActivationRequests")
  premium_requests    PremiumRequest[]     @relation("UserPremiumRequests")
  withdrawal_requests WithdrawalRequest[]
  investments         UserInvestment[]
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt

  @@index([referral_code])
  @@index([referred_by_id])
}

model Designation {
  id         String   @id @default(uuid())
  name       String   // e.g. "1 Star", "2 Star Leader", "VIP Diamond"
  stars      Int      @default(1) // Star count (1, 2, 3, 4, 5)
  max_level  Int      // Unlocked tree level depth (e.g. 1, 2, 3, 5)
  users      User[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model ActivationRequest {
  id               String        @id @default(uuid())
  user_id          String
  referrer_id      String?
  status           RequestStatus @default(PENDING)
  approved_by      String?
  rejection_reason String?
  user             User          @relation("UserActivationRequests", fields: [user_id], references: [id], onDelete: Cascade)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  @@index([user_id])
  @@index([referrer_id])
}

model PremiumRequest {
  id               String        @id @default(uuid())
  user_id          String
  referrer_id      String?
  status           RequestStatus @default(PENDING)
  approved_by      String?
  rejection_reason String?
  user             User          @relation("UserPremiumRequests", fields: [user_id], references: [id], onDelete: Cascade)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  @@index([user_id])
  @@index([referrer_id])
}

model WithdrawalRequest {
  id               String        @id @default(uuid())
  user_id          String
  amount           Decimal       @db.Decimal(12, 2)
  status           RequestStatus @default(PENDING)
  approved_by      String?
  rejection_reason String?
  user             User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  @@index([user_id])
}

model WalletTransaction {
  id             String          @id @default(uuid())
  user_id        String
  type           TransactionType
  amount         Decimal         @db.Decimal(12, 2)
  balance_before Decimal         @db.Decimal(12, 2)
  balance_after  Decimal         @db.Decimal(12, 2)
  description    String?
  user           User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at     DateTime        @default(now())

  @@index([user_id])
}

model CommissionRule {
  id         String         @id @default(uuid())
  type       CommissionType
  level      Int            // 1, 2, 3...
  amount     Decimal        @db.Decimal(12, 2)
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  @@unique([type, level])
}

model Offer {
  id            String   @id @default(uuid())
  title         String
  description   String
  reward_amount Decimal  @db.Decimal(12, 2)
  banner_url    String?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model SystemConfig {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model InvestmentPlan {
  id                     String           @id @default(uuid())
  title                  String
  min_amount             Decimal          @db.Decimal(12, 2)
  max_amount             Decimal          @db.Decimal(12, 2)
  monthly_return_percent Decimal          @db.Decimal(5, 2)
  duration_months        Int              @default(12)
  is_active              Boolean          @default(true)
  investments            UserInvestment[]
  created_at             DateTime         @default(now())
  updated_at             DateTime         @updatedAt
}

model UserInvestment {
  id                     String          @id @default(uuid())
  user_id                String
  plan_id                String?
  amount                 Decimal         @db.Decimal(12, 2)
  monthly_return_percent Decimal         @db.Decimal(5, 2)
  monthly_payout_amount  Decimal         @db.Decimal(12, 2)
  status                 RequestStatus   @default(PENDING)
  total_payouts_made     Int             @default(0)
  max_payouts            Int             @default(12)
  last_payout_at         DateTime?
  next_payout_at         DateTime?
  user                   User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plan                   InvestmentPlan? @relation(fields: [plan_id], references: [id], onDelete: SetNull)
  created_at             DateTime        @default(now())
  updated_at             DateTime        @updatedAt

  @@index([user_id])
  @@index([plan_id])
}

model LeaderboardEntry {
  id              String   @id @default(uuid())
  rank            Int      @unique
  name            String
  phone           String?
  invested_amount Decimal  @db.Decimal(12, 2)
  profit_earned   Decimal  @db.Decimal(12, 2)
  photo_url       String?
  badge           String?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}
