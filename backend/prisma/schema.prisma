generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  DISABLED
  ACTIVE
  BLOCKED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  COMMISSION
  ADMIN_ADJUSTMENT
  PREMIUM_WEEKLY_PAYOUT
  PREMIUM_DAILY_REWARD
  INVESTMENT_DEPOSIT
  INVESTMENT_PAYOUT
  BALANCE_TRANSFER
  COIN_PURCHASE
  ECOMMERCE_ORDER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CoinTransactionType {
  PURCHASE
  PREMIUM_LOCKED_REWARD
  PREMIUM_UNLOCKED
  ADMIN_ADJUSTMENT
  COIN_TRANSFER_SENT
  COIN_TRANSFER_RECEIVED
}

enum CommissionType {
  ACTIVATION
  PREMIUM
}

model Admin {
  id            String              @id @default(uuid())
  phone         String              @unique
  password_hash String
  name          String
  created_at    DateTime            @default(now())
  updated_at    DateTime            @updatedAt
  login_history AdminLoginHistory[]
}

model AdminLoginHistory {
  id         String   @id @default(uuid())
  admin_id   String
  admin      Admin    @relation(fields: [admin_id], references: [id], onDelete: Cascade)
  ip_address String?
  user_agent String?
  status     String   @default("SUCCESS")
  created_at DateTime @default(now())

  @@index([admin_id])
  @@index([created_at])
}

model User {
  id                         String            @id @default(uuid())
  phone                      String?           @unique
  password_hash              String
  full_name                  String?
  email                      String?           @unique
  country                    String?           @default("Bangladesh")
  national_id                String?
  avatar_url                 String?
  referral_code              String            @unique
  referred_by_id             String?
  status                     UserStatus        @default(ACTIVE)
  wallet_balance             Decimal           @default(0.00) @db.Decimal(12, 2)
  coin_balance               Decimal           @default(0.00) @db.Decimal(12, 2)
  locked_coin_balance        Decimal           @default(0.00) @db.Decimal(12, 2)
  premium_coins_granted      Boolean           @default(false)
  is_premium_coins_unlocked  Boolean           @default(false)
  designation_id             String?

  // Premium status fields
  is_premium                 Boolean           @default(false)
  premium_package_id         String?
  premium_package            PremiumPackage?   @relation(fields: [premium_package_id], references: [id], onDelete: SetNull)
  premium_started_at         DateTime?
  premium_expires_at         DateTime?
  premium_payout_count       Int               @default(0)
  last_premium_payout_at     DateTime?

  referred_by                User?               @relation("ReferralTree", fields: [referred_by_id], references: [id], onDelete: SetNull)
  referrals                  User[]              @relation("ReferralTree")
  designation                Designation?        @relation(fields: [designation_id], references: [id], onDelete: SetNull)
  transactions               WalletTransaction[]
  coin_transactions          CoinTransaction[]
  activation_requests        ActivationRequest[]  @relation("UserActivationRequests")
  premium_requests           PremiumRequest[]     @relation("UserPremiumRequests")
  withdrawal_requests        WithdrawalRequest[]  @relation("UserWithdrawalRequests")
  paid_withdrawals           WithdrawalRequest[]  @relation("PaidWithdrawals")
  investments                UserInvestment[]
  deposit_requests           DepositRequest[]
  sent_coin_transfers        CoinTransfer[]       @relation("SentCoinTransfers")
  received_coin_transfers    CoinTransfer[]       @relation("ReceivedCoinTransfers")
  marketplace_posts          MarketplacePost[]
  marketplace_comments       MarketplaceComment[]
  marketplace_likes          MarketplaceLike[]
  daily_ad_claims            DailyAdClaim[]
  orders                     Order[]
  created_at                 DateTime            @default(now())
  updated_at                 DateTime            @updatedAt

  @@index([referral_code])
  @@index([referred_by_id])
  @@index([phone])
  @@index([email])
}

model PremiumPackage {
  id                  String         @id @default(uuid())
  title               String
  description         String?
  original_price      Decimal?       @db.Decimal(12, 2)
  discount_percent    Int?           @default(0)
  price               Decimal        @db.Decimal(12, 2)
  daily_ads_count     Int            @default(30)
  daily_reward_amount Decimal        @db.Decimal(12, 2)
  duration_days       Int            @default(365)
  is_active                  Boolean        @default(true)
  direct_referral_commission Decimal        @default(0) @db.Decimal(12, 2)
  users                      User[]
  daily_claims               DailyAdClaim[]
  created_at                 DateTime       @default(now())
  updated_at                 DateTime       @updatedAt
}

model DailyAdClaim {
  id            String         @id @default(uuid())
  user_id       String
  package_id    String
  claim_date    String         // YYYY-MM-DD
  ads_watched   Int            @default(0)
  is_claimed    Boolean        @default(false)
  reward_amount Decimal        @db.Decimal(12, 2)
  claimed_at    DateTime?
  user          User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  package       PremiumPackage @relation(fields: [package_id], references: [id], onDelete: Cascade)
  created_at    DateTime       @default(now())

  @@unique([user_id, claim_date])
  @@index([user_id])
}

model DepositRequest {
  id               String        @id @default(uuid())
  user_id          String
  method           String        // "BKASH", "NAGAD", "ROCKET"
  sender_number    String
  amount           Decimal       @db.Decimal(12, 2)
  trx_id           String        @unique
  status           RequestStatus @default(PENDING)
  approved_by      String?
  approved_at      DateTime?
  rejection_reason String?
  user             User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  @@index([user_id])
  @@index([trx_id])
  @@index([status])
}

model CoinTransfer {
  id              String        @id @default(uuid())
  sender_id       String
  receiver_id     String
  coin_amount     Decimal       @db.Decimal(12, 2)
  coin_rate       Decimal       @db.Decimal(12, 2)
  total_bdt_value Decimal       @db.Decimal(12, 2)
  note            String?
  status          RequestStatus @default(PENDING) // PENDING, APPROVED, REJECTED
  responded_at    DateTime?
  sender          User          @relation("SentCoinTransfers", fields: [sender_id], references: [id], onDelete: Cascade)
  receiver        User          @relation("ReceivedCoinTransfers", fields: [receiver_id], references: [id], onDelete: Cascade)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  @@index([sender_id])
  @@index([receiver_id])
  @@index([status])
}

model MarketplacePost {
  id         String               @id @default(uuid())
  user_id    String
  content    String
  image_url  String?
  user       User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  likes      MarketplaceLike[]
  comments   MarketplaceComment[]
  created_at DateTime             @default(now())
  updated_at DateTime             @updatedAt

  @@index([user_id])
  @@index([created_at])
}

model MarketplaceLike {
  id         String          @id @default(uuid())
  post_id    String
  user_id    String
  post       MarketplacePost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at DateTime        @default(now())

  @@unique([post_id, user_id])
}

model MarketplaceComment {
  id         String               @id @default(uuid())
  post_id    String
  user_id    String
  parent_id  String?
  content    String
  post       MarketplacePost      @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent     MarketplaceComment?  @relation("CommentReplies", fields: [parent_id], references: [id], onDelete: Cascade)
  replies    MarketplaceComment[] @relation("CommentReplies")
  created_at DateTime             @default(now())
  updated_at DateTime             @updatedAt

  @@index([post_id])
  @@index([parent_id])
}

model CoinTransaction {
  id           String              @id @default(uuid())
  user_id      String
  type         CoinTransactionType
  amount       Decimal             @db.Decimal(12, 2)
  coins_before Decimal             @db.Decimal(12, 2)
  coins_after  Decimal             @db.Decimal(12, 2)
  cost_bdt     Decimal?            @db.Decimal(12, 2)
  description  String?
  user         User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at   DateTime            @default(now())

  @@index([user_id])
}

model Designation {
  id         String   @id @default(uuid())
  name       String   // e.g. "1 Star", "2 Star Leader", "VIP Diamond"
  stars      Int      @default(1)
  max_level  Int
  users      User[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model ActivationRequest {
  id               String        @id @default(uuid())
  user_id          String
  referrer_id      String?
  status           RequestStatus @default(PENDING)
  approved_by      String?
  rejection_reason String?
  user             User          @relation("UserActivationRequests", fields: [user_id], references: [id], onDelete: Cascade)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  @@index([user_id])
  @@index([referrer_id])
}

model PremiumRequest {
  id               String        @id @default(uuid())
  user_id          String
  referrer_id      String?
  status           RequestStatus @default(PENDING)
  approved_by      String?
  rejection_reason String?
  user             User          @relation("UserPremiumRequests", fields: [user_id], references: [id], onDelete: Cascade)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  @@index([user_id])
  @@index([referrer_id])
}

model WithdrawalRequest {
  id               String        @id @default(uuid())
  user_id          String
  amount           Decimal       @db.Decimal(12, 2)
  otp              String?
  otp_expires_at   DateTime?
  status           RequestStatus @default(PENDING)
  approved_by      String?
  paid_to_user_id  String?
  paid_at          DateTime?
  rejection_reason String?
  user             User          @relation("UserWithdrawalRequests", fields: [user_id], references: [id], onDelete: Cascade)
  paid_to_user     User?         @relation("PaidWithdrawals", fields: [paid_to_user_id], references: [id], onDelete: SetNull)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  @@index([user_id])
  @@index([paid_to_user_id])
  @@index([otp])
  @@index([status])
}

model OtpVerification {
  id           String    @id @default(uuid())
  target       String?   // Phone number OR Email address
  phone        String?   // Backward compatible phone field
  email        String?   // Email address field
  channel      String    @default("SMS") // "SMS" | "EMAIL"
  otp          String    // 6-digit numerical code
  purpose      String    // "SIGNUP", "WITHDRAWAL", "FORGOT_PASSWORD"
  attempts     Int       @default(0)
  is_verified  Boolean   @default(false)
  expires_at   DateTime
  last_sent_at DateTime  @default(now())
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([target, purpose])
  @@index([phone, purpose])
}

model WalletTransaction {
  id             String          @id @default(uuid())
  user_id        String
  type           TransactionType
  amount         Decimal         @db.Decimal(12, 2)
  balance_before Decimal         @db.Decimal(12, 2)
  balance_after  Decimal         @db.Decimal(12, 2)
  description    String?
  user           User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at     DateTime        @default(now())

  @@index([user_id])
}

model CommissionRule {
  id         String         @id @default(uuid())
  type       CommissionType
  level      Int
  amount     Decimal        @db.Decimal(12, 2)
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  @@unique([type, level])
}

model Offer {
  id            String   @id @default(uuid())
  title         String
  description   String
  reward_amount Decimal  @db.Decimal(12, 2)
  banner_url    String?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model SystemConfig {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model InvestmentPlan {
  id                     String           @id @default(uuid())
  title                  String
  amount                 Decimal          @default(0) @db.Decimal(12, 2)
  min_amount             Decimal          @db.Decimal(12, 2)
  max_amount             Decimal?         @db.Decimal(12, 2)
  monthly_return_percent Decimal          @db.Decimal(5, 2)
  duration_months        Int?             @default(12)
  is_lifetime            Boolean          @default(false)
  is_active              Boolean          @default(true)
  investments            UserInvestment[] @relation("ActivePlan")
  pending_investments    UserInvestment[] @relation("PendingPlan")
  created_at             DateTime         @default(now())
  updated_at             DateTime         @updatedAt
}

model UserInvestment {
  id                     String          @id @default(uuid())
  user_id                String
  plan_id                String?
  amount                 Decimal         @db.Decimal(12, 2)
  monthly_return_percent Decimal         @db.Decimal(5, 2)
  monthly_payout_amount  Decimal         @db.Decimal(12, 2)
  status                 RequestStatus   @default(APPROVED)
  request_type           String          @default("NEW")
  pending_plan_id        String?
  pending_amount         Decimal?        @db.Decimal(12, 2)
  total_payouts_made     Int             @default(0)
  max_payouts            Int?            @default(12)
  duration_months        Int?            @default(12)
  is_lifetime            Boolean         @default(false)
  starts_at              DateTime        @default(now())
  ends_at                DateTime?
  is_principal_returned  Boolean         @default(false)
  last_payout_at         DateTime?
  next_payout_at         DateTime?
  user                   User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plan                   InvestmentPlan? @relation("ActivePlan", fields: [plan_id], references: [id], onDelete: SetNull)
  pending_plan           InvestmentPlan? @relation("PendingPlan", fields: [pending_plan_id], references: [id], onDelete: SetNull)
  created_at             DateTime        @default(now())
  updated_at             DateTime        @updatedAt

  @@index([user_id])
  @@index([plan_id])
  @@index([pending_plan_id])
}

model LeaderboardEntry {
  id              String   @id @default(uuid())
  rank            Int      @unique
  name            String
  phone           String?
  invested_amount Decimal  @db.Decimal(12, 2)
  profit_earned   Decimal  @db.Decimal(12, 2)
  photo_url       String?
  badge           String?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

model Notice {
  id            String   @id @default(uuid())
  title         String?  @default("Notice banner")
  content       String?  @default("")
  image_url     String?
  link_url      String?
  serial_number Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model Product {
  id          String      @id @default(uuid())
  name        String
  description String?     @db.Text
  price       Decimal     @db.Decimal(12, 2)
  images      String[]    @default([])
  stock       Int         @default(100)
  category    String?     @default("General")
  is_active   Boolean     @default(true)
  order_items OrderItem[]
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  @@index([created_at])
  @@index([is_active])
}

model Order {
  id               String      @id @default(uuid())
  order_number     String      @unique
  user_id          String
  user             User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  total_amount     Decimal     @db.Decimal(12, 2)
  status           OrderStatus @default(PENDING)
  customer_name    String
  customer_phone   String
  district         String
  city             String?
  delivery_address String      @db.Text
  notes            String?
  payment_method   String      @default("WALLET")
  paid_at          DateTime    @default(now())
  items            OrderItem[]
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  @@index([user_id])
  @@index([status])
  @@index([created_at])
}

model OrderItem {
  id            String   @id @default(uuid())
  order_id      String
  order         Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_id    String?
  product       Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)
  product_name  String
  product_image String?
  unit_price    Decimal  @db.Decimal(12, 2)
  quantity      Int      @default(1)
  total_price   Decimal  @db.Decimal(12, 2)

  @@index([order_id])
  @@index([product_id])
}
